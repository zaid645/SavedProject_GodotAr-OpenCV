; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node",
"class": "ARImageLibrary",
"language": "GDScript",
"path": "res://global/ar_image_library.gd"
}, {
"base": "Node",
"class": "ARImageSession",
"language": "GDScript",
"path": "res://global/ar_image_session.gd"
}, {
"base": "Spatial",
"class": "ARImageSpawner",
"language": "GDScript",
"path": "res://global/ar_image_spawner.gd"
}, {
"base": "Spatial",
"class": "ARMarkerSpawner",
"language": "GDScript",
"path": "res://global/ar_marker_spawner.gd"
}, {
"base": "Node",
"class": "ARSession",
"language": "GDScript",
"path": "res://global/ar.gd"
} ]
_global_script_class_icons={
"ARImageLibrary": "",
"ARImageSession": "",
"ARImageSpawner": "",
"ARMarkerSpawner": "",
"ARSession": ""
}

[application]

config/name="Godot CPP OpenCV"
run/main_scene="res://Main2D.tscn"
config/icon="res://icon.png"

[display]

window/size/width=640
window/size/height=480
window/stretch/mode="viewport"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
environment/default_environment="res://default_env.tres"
